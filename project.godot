; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Jogo de Vôlei"
config/description="Vôlei de quadra 6 contra 6, anime cel-shaded, para 2 jogadores."
run/main_scene="res://cenas/menu_principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Teclas="*res://scripts/entrada/teclas.gd"
Configuracao="*res://scripts/menus/configuracao.gd"
Rede="*res://scripts/rede/rede.gd"
Musica="*res://scripts/audio/musica.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]

anti_aliasing/quality/msaa_3d=2

[editor_plugins]

enabled=PackedStringArray("res://addons/mtoon/plugin.cfg", "res://addons/vrm/plugin.cfg")

[vrm]

import/bone_rename=1
import/skeleton_name="GeneralSkeleton"
